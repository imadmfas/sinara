{
  "name": "sinara",
  "version": "0.1.0",
  "description": "سِينارة — منصة عراقية لتعلّم مهارات التعامل مع الذكاء الاصطناعي",
  "scripts": {
    "dev": "vite",
    "validate": "tsx scripts/validate-content.ts",
    "build": "npm run catalog && npm run validate && tsc -b && vite build",
    "build:native": "npm run catalog && npm run validate && tsc -b && vite build --mode native",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "cap:sync": "npm run build:native && cap sync",
    "server:test": "vitest run --root server",
    "catalog": "tsx scripts/build-catalog.ts",
    "predev": "npm run catalog"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@capacitor/android": "^6.2.3",
    "@capacitor/core": "^6.2.3",
    "@capacitor/ios": "^6.2.3",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.3",
    "@playwright/test": "^1.65.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^2.1.9",
    "workbox-window": "^7.4.1"
  },
  "private": true,
  "type": "module"
}